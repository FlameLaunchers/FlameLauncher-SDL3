+
+// ── 프래그먼트 출력 배열의 동적 인덱싱 풀기 ────────────────────────────────
+//
+// GLSL ES 는 `out vec4 color[N]` 을 **상수로만** 인덱싱하게 한다(S0015). 그런데
+// 마인크래프트 26.3 의 셰이더는 상수 범위 반복문 안에서 변수로 인덱싱한다:
+//
+//     for (int attachmentIndex = 0; attachmentIndex < 2; attachmentIndex++)
+//         for (int i_1 = 0; i_1 < 4; i_1++)
+//             _frag_output_00[attachmentIndex][i_1] = coefficients[...];
+//
+// 범위가 리터럴이므로 펼치면 인덱스가 상수가 된다. 출력 배열을 건드리는 반복문만,
+// 그리고 SPIRV-Cross 가 내는 정형화된 형태일 때만 손댄다 — 그 외에는 그대로 둔다.
+static std::vector<std::string> flame_out_array_names(const std::string& code) {
+    static const std::regex decl(
+        R"(out\s+(?:highp\s+|mediump\s+|lowp\s+)?\w+\s+(\w+)\s*\[\s*\d+\s*\]\s*;)");
+    std::vector<std::string> names;
+    for (std::sregex_iterator it(code.begin(), code.end(), decl), end; it != end; ++it)
+        names.push_back((*it)[1].str());
+    return names;
+}
+
+static bool flame_body_indexes_out_array(const std::string& body, const std::vector<std::string>& names,
+                                         const std::string& var) {
+    if (body.find(var) == std::string::npos) return false;
+    for (const auto& n : names) {
+        size_t at = body.find(n + "[");
+        if (at != std::string::npos) return true;
+    }
+    return false;
+}
+
+static std::string flame_replace_word(const std::string& text, const std::string& word, const std::string& with) {
+    std::string out;
+    out.reserve(text.size());
+    size_t pos = 0;
+    auto ident = [](char c) { return std::isalnum(static_cast<unsigned char>(c)) != 0 || c == '_'; };
+    while (true) {
+        size_t at = text.find(word, pos);
+        if (at == std::string::npos) {
+            out.append(text, pos, std::string::npos);
+            return out;
+        }
+        const bool left = at > 0 && ident(text[at - 1]);
+        const size_t after = at + word.size();
+        const bool right = after < text.size() && ident(text[after]);
+        out.append(text, pos, at - pos);
+        out.append((left || right) ? word : with);
+        pos = after;
+    }
+}
+
+std::string unroll_out_array_loops(const std::string& glslCode) {
+    const std::vector<std::string> names = flame_out_array_names(glslCode);
+    if (names.empty()) return glslCode;
+
+    // `for (int NAME = 0; NAME < K; NAME++)` — SPIRV-Cross 가 내는 형태 그대로.
+    static const std::regex loop(
+        R"(for\s*\(\s*int\s+(\w+)\s*=\s*0\s*;\s*\1\s*<\s*(\d+)\s*;\s*(?:\1\s*\+\+|\+\+\s*\1)\s*\)\s*\{)");
+
+    std::string code = glslCode;
+    for (int pass = 0; pass < 8; ++pass) {   // 중첩 반복문은 바깥부터 한 겹씩
+        std::smatch m;
+        bool changed = false;
+        size_t from = 0;
+        while (std::regex_search(code.cbegin() + from, code.cend(), m, loop)) {
+            const size_t head = from + m.position(0);
+            const size_t body_start = from + m.position(0) + m.length(0);   // '{' 다음
+            const std::string var = m[1].str();
+            const int count = std::stoi(m[2].str());
+
+            // 짝이 맞는 '}' 찾기
+            int depth = 1;
+            size_t i = body_start;
+            for (; i < code.size() && depth > 0; ++i) {
+                if (code[i] == '{') ++depth;
+                else if (code[i] == '}') --depth;
+            }
+            if (depth != 0) break;
+            const size_t body_end = i - 1;   // '}' 위치
+            const std::string body = code.substr(body_start, body_end - body_start);
+
+            if (count > 0 && count <= 64 && flame_body_indexes_out_array(body, names, var)) {
+                std::string unrolled;
+                unrolled.reserve(body.size() * count + 16);
+                for (int k = 0; k < count; ++k) {
+                    unrolled += "\n{";
+                    unrolled += flame_replace_word(body, var, std::to_string(k));
+                    unrolled += "}\n";
+                }
+                code = code.substr(0, head) + unrolled + code.substr(body_end + 1);
+                changed = true;
+                from = head + unrolled.size();
+            } else {
+                from = body_end;
+            }
+            if (from >= code.size()) break;
+        }
+        if (!changed) break;
+    }
+    return code;
+}
